    kx[i]= (long) (fx1 * ( (x[i] +fux* ux[i] )-cx) *facx*fxcor + fx2);
    ky[i]= (long)-(fy1 * ( (z[i] +fuz* uz[i] )-cz) *facz       - fy2);
    }
  }
else if(ifansi== IDM_YZ)
  {
  for(i= 1; i <= nkp; i++)
    {
    kx[i]= (long) (fx1 * ( (y[i] +fuy* uy[i] )-cy) *facy*fxcor + fx2);
    ky[i]= (long)-(fy1 * ( (z[i] +fuz* uz[i] )-cz) *facz       - fy2);
    }
  }

return 0;
}

