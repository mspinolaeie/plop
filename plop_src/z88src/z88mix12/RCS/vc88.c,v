/***********************************************************************
*  function vu2b88
***********************************************************************/
int vu2b88(void)
{
extern FR_DOUBLEAY x;
extern FR_DOUBLEAY y;
extern FR_DOUBLEAY z;

extern double facx,facy,facz,cx,cy,cz,fxcor;

extern FR_INT4AY kx;
extern FR_INT4AY ky;

extern FR_INT4 nkp;

extern int ifansi;

extern short ixClient, iyClient;
        
double fx1,fx2,fy1,fy2;
        
FR_INT4 i;

fx1= ixClient*0.005;
fx2= ixClient*0.5;
fy1= iyClient*0.005;
fy2= iyClient*0.5;

if(ifansi== IDM_XY)
  {
  for(i= 1; i <= nkp; i++)
    {
    kx[i]= (long) (fx1 * (x[i] -cx) *facx*fxcor + fx2);
    ky[i]= (long)-(fy1 * (y[i] -cy) *facy       - fy2);
    }
  }
else if(ifansi== IDM_XZ)
  {
  for(i= 1; i <= nkp; i++)
    {
    kx[i]= (long) (fx1 * (x[i] -cx) *facx*fxcor + fx2);
    ky[i]= (long)-(fy1 * (z[i] -cz) *facz       - fy2);
    }
  }
else if(ifansi== IDM_YZ)
  {
  for(i= 1; i <= nkp; i++)
    {
    kx[i]= (long) (fx1 * (y[i] -cy) *facy*fxcor + fx2);
    ky[i]= (long)-(fy1 * (z[i] -cz) *facz       - fy2);
    }
  }
  
return 0;
}

/***********************************************************************
*  function vu3b88
***********************************************************************/
int vu3b88(void)
{
extern FR_DOUBLEAY x;
extern FR_DOUBLEAY y;
extern FR_DOUBLEAY z;

extern double facx,facy,facz,cx,cy,cz,rotx,roty,rotz,fxcor;

extern FR_INT4AY kx;
extern FR_INT4AY ky;

extern FR_INT4 nkp;

extern short ixClient, iyClient;

double gx,gy,gz,hx,hy,hz,wx,wy,wz,sa,sb,sc,sd,se,sf,sg,sh,si,fpi;
double fx1,fx2,fy1,fy2;
        
FR_INT4 i;

fx1= ixClient*0.005;
fx2= ixClient*0.5;
fy1= iyClient*0.005;
fy2= iyClient*0.5;

fpi= 0.0174533;
        
wx= rotx*fpi;
wy= roty*fpi;
wz= rotz*fpi;
        
sa= cos(wy) * cos(wz);
sb= cos(wy) * sin(wz);
sc= -sin(wy);
sd= sin(wx) * sin(wy) * cos(wz) - cos(wx) * sin(wz);
se= sin(wx) * sin(wy) * sin(wz) + cos(wx) * cos(wz);
sf= sin(wx) * cos(wy);
sg= cos(wx) * sin(wy) * cos(wz) + sin(wx) * sin(wz);
sh= cos(wx) * sin(wy) * sin(wz) - sin(wx) * cos(wz);
si= cos(wx) * cos(wy);

for(i= 1; i <= nkp; i++)
  {
  gx= (x[i] - cx) * facx;
  gy= (y[i] - cy) * facy;
  gz= (z[i] - cz) * facz;
  hx= gx * sa + gy * sb + gz * sc;
  hy= gx * sd + gy * se + gz * sf;
  hz= gx * sg + gy * sh + gz * si;
  kx[i]= (long) (fx1 * ((hx - hy) * 0.866) * fxcor + fx2);
  ky[i]= (long)-(fy1 * ((hx + hy) * 0.500 +hz)     - fy2);
  }
return 0;
}

