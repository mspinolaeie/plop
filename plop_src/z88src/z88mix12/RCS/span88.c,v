#include <z88d.h>
#endif

/***********************************************************************
* Start span88
***********************************************************************/
int span88(void)
{
extern FR_DOUBLEAY u;

extern FR_DOUBLE ul[];

extern FR_INT4 mspan[];

extern FR_INT4 mxknot,mxfrei;

FR_INT4 j,j2,l,mspanj;
        
for(j = 1;j <= mxknot;j++)
  {
  for(j2 = 1;j2 <= mxfrei;j2++)
    {
    mspanj= mspan[j] + j2;
    l= mxfrei*(j-1) + j2;
    ul[l]= u[mspanj];
    }
  }
            
return(0);
}
