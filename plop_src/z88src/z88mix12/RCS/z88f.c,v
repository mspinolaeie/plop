/***********************************************************************
* WinMain
***********************************************************************/
int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance,
                   PSTR lpszCmdLine, int nCmdShow)
{
HWND       hWnd;
MSG        msg;
WNDCLASSEX wndclass;

char       capname[10];
       
/***********************************************************************
* Handles kommen lassen, window oeffnen
***********************************************************************/
strcpy(capname, "Z88F");

wndclass.cbSize        = sizeof(wndclass);
wndclass.style         = CS_HREDRAW | CS_VREDRAW;
wndclass.lpfnWndProc   = WndProc;
wndclass.cbClsExtra    = 0;
wndclass.cbWndExtra    = 0;
wndclass.hInstance     = hInstance;
wndclass.hIcon         = LoadIcon(hInstance, MAKEINTRESOURCE(ICO_Z88F));
wndclass.hCursor       = LoadCursor(NULL, IDC_ARROW);
/* wndclass.hbrBackground = (HBRUSH)(COLOR_WINDOW+1); */
wndclass.hbrBackground = CreateSolidBrush(RGB(255,128,0));
wndclass.lpszMenuName  = capname;
wndclass.lpszClassName = capname;
wndclass.hIconSm       = LoadIcon(hInstance, MAKEINTRESOURCE(ICO_Z88F));

RegisterClassEx(&wndclass);

hWnd = CreateWindow(capname,"Z88 Cholesky Solver Z88F",
                    WS_OVERLAPPEDWINDOW,
                    150,220,
                    520,360,
                    NULL, NULL, hInstance, NULL);

InitCommonControls();

ShowWindow(hWnd, nCmdShow);
UpdateWindow(hWnd);

while(GetMessage(&msg, NULL, 0, 0))
  {
  TranslateMessage(&msg);
  DispatchMessage(&msg);
  }

DeleteObject(hFont);

return msg.wParam;
}

/***********************************************************************
* Main Window Procedure
***********************************************************************/
LRESULT CALLBACK WndProc(HWND hWnd, UINT Message,
                         WPARAM wParam, LPARAM lParam)
{
extern HDC        hDC;
extern HINSTANCE  hInstance;
extern HFONT      hFont;

extern HWND       hToolBar;
extern HMENU      hMenuGer,hMenuEng;

extern HCURSOR    waitcur;

extern FR_INT4    ICFLAG,LANG;
extern int        ifmode;

extern char       cstore[];
extern char       cbcall[];
extern char       cbpref[];
extern char       cbhelp[];
extern char       cmess[];

HMENU             hMenu;

PAINTSTRUCT       ps;

static int        ixClient,iyClient;

int               imess,iret;

size_t            laenge;

/*----------------------------------------------------------------------
* Los gehts
*---------------------------------------------------------------------*/
switch (Message)
  {
/*----------------------------------------------------------------------
* case WM_CREATE
*---------------------------------------------------------------------*/
  case WM_CREATE:

/*======================================================================
* hInstance kommen lassen
*=====================================================================*/
    hInstance= (HINSTANCE)GetWindowLong(hWnd,GWL_HINSTANCE);

/*======================================================================
* Wartecursor anlegen
*=====================================================================*/
    waitcur= LoadCursor(hInstance,MAKEINTRESOURCE(CUR_Z88F));

/*======================================================================
* Sprache feststellen
*=====================================================================*/
    iret= lan88f();
    if(iret != 0)
      {
      ale88f(iret);
      PostQuitMessage(0);
      return(1);
      }

    hMenuGer= LoadMenu(hInstance,"GERMAN");
    hMenuEng= LoadMenu(hInstance,"ENGLISH");

    if(LANG == 1) SetMenu(hWnd,hMenuGer);
    if(LANG == 2) SetMenu(hWnd,hMenuEng);

/*======================================================================
* dynamischen Speicher anfordern
*=====================================================================*/
    iret= dyn88f();
    if(iret != 0) 
      { 
      ale88f(iret);
      PostQuitMessage(0);
      return 0;
      }           

/*===========================================================================
* ICFLAG setzen
*==========================================================================*/
    if(ifmode == IDM_COMPAKTMODE) ICFLAG = 1;

/*======================================================================
* Toolbar
*=====================================================================*/
    hToolBar= InitToolBar(hWnd);

  return 0; /* Ende WM_CREATE */

/*----------------------------------------------------------------------
* case WM_INITMENU
*---------------------------------------------------------------------*/
  case WM_INITMENU:
    hMenu= GetMenu(hWnd); /* muss rein */

    CheckMenuItem(hMenu,IDM_COMPAKTMODE, MF_UNCHECKED | MF_BYCOMMAND);   
    CheckMenuItem(hMenu,IDM_TESTMODE,    MF_UNCHECKED | MF_BYCOMMAND);   
    CheckMenuItem(hMenu,ifmode,          MF_CHECKED   | MF_BYCOMMAND);   
  return 0;
  
/*----------------------------------------------------------------------
* case WM_MOVE
*---------------------------------------------------------------------*/
  case WM_MOVE:
  return 0;

/*----------------------------------------------------------------------
* case WM_SIZE
*---------------------------------------------------------------------*/
  case WM_SIZE:
    iyClient= HIWORD(lParam);
    ixClient= LOWORD(lParam);
  return 0;

/*----------------------------------------------------------------------
* WM_NOTIFY
*---------------------------------------------------------------------*/
  case WM_NOTIFY:
    {
    LPNMHDR pnmh= (LPNMHDR) lParam;
    LPSTR   pReply;

    if(pnmh->code == TTN_NEEDTEXT)
      {
      LPTOOLTIPTEXT lpttt= (LPTOOLTIPTEXT) lParam;

      switch(lpttt->hdr.idFrom)
        {
        case ITC_GO:
          if(LANG == 1) pReply= "Berechne die Verformungen";
          if(LANG == 2) pReply= "Run the displacement calculation";
        break;

        case ITC_HELP:
          if(LANG == 1) pReply= "OnLine-Hilfe fuer Cholesky Solver";
          if(LANG == 2) pReply= "OnLine Help for Cholesky Solver";
        break;

        case ITC_COMPAKTMODE:
          if(LANG == 1) pReply= "Rechenmode fuer Cholesky Solver";
          if(LANG == 2) pReply= "Compute Mode for Cholesky Solver";
        break;

        case ITC_TESTMODE:
          if(LANG == 1) pReply= "Testmode fuer Cholesky Solver";
          if(LANG == 2) pReply= "Test Mode for Cholesky Solver";
        break;

        }
      lstrcpy(lpttt->szText,pReply);
      }
    return 0;  /* sehr wichtig */
    }

/*----------------------------------------------------------------------
* case WM_COMMAND
*---------------------------------------------------------------------*/
  case WM_COMMAND:
    switch (LOWORD(wParam))
      {

/*======================================================================
* COMMAND : Wer ist es
*=====================================================================*/
      case IDM_WER:
        if(LANG == 1) strcpy(cmess,
"FE Prozessor Z88F fuer Windows\n\
Version 12.0\n\
Der direkte Cholesky Solver\n\
Copyright Univ.-Prof.Dr.-Ing. Frank Rieg,\n\
Universitaet Bayreuth, 2005\n\
Alle Rechte vorbehalten");
          if(LANG == 2) strcpy(cmess,
"FEA Solver Z88F for Windows\n\
Version 12.0\n\
The direct Cholesky solver\n\
Copyright Prof.Dr. Frank Rieg,\n\
University of Bayreuth, Germany 2005\n\
All rights reserved");
        MessageBox(NULL,cmess,"Z88F", MB_OK | MB_ICONINFORMATION);
      return 0;

/*======================================================================
* COMMAND : Xit
*=====================================================================*/
      case IDM_XIT:
        if(LANG == 1) strcpy(cmess,"Z88F beenden ?");
        if(LANG == 2) strcpy(cmess,"Quit Z88F ?");
        imess= MessageBox(NULL,cmess,"Z88F",MB_OKCANCEL | MB_ICONQUESTION);
        if(imess == IDOK)     PostQuitMessage(0);
        if(imess == IDCANCEL) return 0;  
      return 0; 

/*======================================================================
* COMMAND : Hilfe
*=====================================================================*/
      case ITC_HELP:
        fcfg= fopen(cfg,"r");          /* Z88COM.CFG oeffnen */
        if(fcfg == NULL)
          {
          if(LANG == 1) strcpy(cmess,
          "Datei Z88COM.CFG nicht vorhanden oder zerschossen !");
          if(LANG == 2) strcpy(cmess,
          "File Z88COM.CFG not available or destroyed !");
          MessageBox(NULL,cmess,"Z88F", MB_OK | MB_ICONHAND);
          }

        rewind(fcfg);

        fgets(cstore,128,fcfg);
        fgets(cstore,128,fcfg);

        fgets(cstore,128,fcfg);
        laenge= strlen(cstore);
        strncpy(cbpref,cstore,laenge-1);
        strcat (cbpref,"\0");

        fgets(cstore,128,fcfg);
        laenge= strlen(cstore);
        strncpy(cbcall,cstore,laenge-1);
        strcat (cbcall,"\0");

        fclose(fcfg); 

        strcpy(cbhelp,cbcall);
        strcat(cbhelp," ");
        strcat(cbhelp,cbpref);
        if(LANG == 1) strcat(cbhelp,"g88f.htm");
        if(LANG == 2) strcat(cbhelp,"e88f.htm");
        imess= WinExec(cbhelp,SW_SHOW);
        if(imess < 33)
          {
          if(LANG == 1) strcpy(cmess,
          "Internet Browser konnte nicht gestartet werden !");
          if(LANG == 2) strcpy(cmess,
          "Could not launch Internet Browser !");
          MessageBox(NULL,cmess,"Z88F", MB_OK | MB_ICONHAND);
          }

      return 0;

/*======================================================================
* COMMAND : Mode aus Menue
*=====================================================================*/
      case IDM_COMPAKTMODE:
      case IDM_TESTMODE:
        hMenu= GetMenu(hWnd);
        CheckMenuItem(hMenu,ifmode,MF_UNCHECKED | MF_BYCOMMAND);
        ifmode= LOWORD(wParam);
        CheckMenuItem(hMenu,ifmode,MF_CHECKED | MF_BYCOMMAND);   

        if     (ifmode == IDM_COMPAKTMODE) 
          {
          ICFLAG = 1;
          SendMessage(hToolBar,TB_CHECKBUTTON,
          (WPARAM)ITC_COMPAKTMODE,(LPARAM) MAKELONG(TRUE,0) );
          SendMessage(hToolBar,TB_CHECKBUTTON,
          (WPARAM)ITC_TESTMODE,(LPARAM) MAKELONG(FALSE,0) );
          }

        else if(ifmode == IDM_TESTMODE)
          {
          ICFLAG = 4;
          SendMessage(hToolBar,TB_CHECKBUTTON,
          (WPARAM)ITC_COMPAKTMODE,(LPARAM) MAKELONG(FALSE,0) );
          SendMessage(hToolBar,TB_CHECKBUTTON,
          (WPARAM)ITC_TESTMODE,(LPARAM) MAKELONG(TRUE,0) );
          }

        else MessageBox(NULL,"No Mode !","Z88F", MB_OK | MB_ICONHAND);
        InvalidateRect(hWnd,NULL,TRUE);
      return 0; 

/*======================================================================
* COMMAND : Mode aus Toolbar
*=====================================================================*/
      case ITC_COMPAKTMODE:
        ICFLAG = 1;
        ifmode = IDM_COMPAKTMODE; 
        InvalidateRect(hWnd,NULL,TRUE);
      return 0;

      case ITC_TESTMODE:
        ICFLAG = 4;
        ifmode = IDM_TESTMODE; 
        InvalidateRect(hWnd,NULL,TRUE);
      return 0;

/*======================================================================
* COMMAND : Go
*=====================================================================*/
      case IDM_GO:
      case ITC_GO:
        SetCursor(waitcur);
        ShowCursor(TRUE);
        
        hDC= GetDC(hWnd);
        hFont= EzCreateFont(hDC,"Times New Roman",120,0,2,TRUE);
        SelectObject(hDC,hFont);
        SetBkColor(hDC,RGB(255,128,0));

        if     (ICFLAG == 1) wlog88f(1L,LOG_CFLAGC);
        else if(ICFLAG == 4) wlog88f(4L,LOG_CFLAGT);
         
/*---------------------------------------------------------------------------
* Entscheiden, welcher Berechnungsgang
*--------------------------------------------------------------------------*/
        if(ICFLAG == 4 )
          {                            /* Start /T */ 

/*---------------------------------------------------------------------------
* Berechnungsgang 4: nur Z88A und WRIA88F zum Grenzentesten
*--------------------------------------------------------------------------*/
/*===========================================================================
* Einlesen Z88I1.TXT
*==========================================================================*/
          iret= ri188();
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           
  
/*===========================================================================
* Rechnen
*==========================================================================*/
          iret= z88a();
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           

          iret= wria88f();            /* Schreiben Z88O1.TXT und Z88O1.BNY */ 
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           
          }
/*---------------------------------------------------------------------------
* Ende Berechnungsgang 4
*--------------------------------------------------------------------------*/
  
        if(ICFLAG == 1)
          {                            /* Start /C */ 

/*---------------------------------------------------------------------------
* Berechnungsgang 1
*--------------------------------------------------------------------------*/
/*===========================================================================
* Einlesen Z88I1.TXT
*==========================================================================*/
          iret= ri188();
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           
  
/*===========================================================================
* Rechnen
*==========================================================================*/
          iret= z88a();
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           

          iret= wria88f();            /* Schreiben Z88O1.TXT und Z88O1.BNY */ 
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           

          iret= z88b();
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           

          iret= z88cc();
          if(iret != 0)
            {
            ale88f(iret);
            PostQuitMessage(0);
            return(0);
            }           
          }                            /* Ende /C */
/*---------------------------------------------------------------------------
* Ende Berechnungsgang 1
*--------------------------------------------------------------------------*/

        if(LANG == 1) strcpy(cmess,"FE-Prozessor Z88F gelaufen");
        if(LANG == 2) strcpy(cmess,"FEA-Solver Z88F done");
        MessageBox(NULL,cmess,"Z88F", MB_OK | MB_ICONINFORMATION);
        ReleaseDC(hWnd,hDC);  
        SetCursor(LoadCursor(NULL,IDC_ARROW));
      return 0;                           /* end case GO */

      default:
        return DefWindowProc(hWnd, Message, wParam, lParam);
      }                                /* end switch command */ 

/*----------------------------------------------------------------------
* case WM_PAINT
*---------------------------------------------------------------------*/
  case WM_PAINT:
    memset(&ps, 0x00, sizeof(PAINTSTRUCT));
    hDC = BeginPaint(hWnd, &ps);

    SetBkMode(hDC, TRANSPARENT);

    EndPaint(hWnd, &ps);
  return 0;

/*----------------------------------------------------------------------
* case WM_CLOSE
*---------------------------------------------------------------------*/
  case WM_CLOSE:
    PostQuitMessage(0);
  return 0;

/*----------------------------------------------------------------------
* case WM_DESTROY
*---------------------------------------------------------------------*/
  case WM_DESTROY:
    PostQuitMessage(0);
  return 0;

  default:
    return DefWindowProc(hWnd, Message, wParam, lParam);
  } 
}
@
