#ifdef FR_WIN95
#include <z88d.h>
#include <windows.h>
#include <string.h>   /* strlen  */
#include <stdio.h>    /* sprintf */
#endif

/***********************************************************************
*  hier beginnt Function wrim88d
***********************************************************************/
int wrim88d(FR_INT4 i,int iatx)
{
extern HDC hDC;
extern FR_INT4 LANG;

switch(iatx)
  {
  case TX_REAO1Y:
    if(LANG == 1) TextOut(hDC,10,50,"Z88O1.BNY einlesen",18);
    if(LANG == 2) TextOut(hDC,10,50,"reading Z88O1.BNY",17);
  break;

  case TX_REAO3Y:
    if(LANG == 1) TextOut(hDC,10,70,"Z88O3.BNY einlesen",18);
    if(LANG == 2) TextOut(hDC,10,70,"reading Z88O3.BNY",17);
  break;

  case TX_SPANNU:
    if(LANG == 1) TextOut(hDC,10,110,"Spannungen berechnen und schreiben",34);
    if(LANG == 2) TextOut(hDC,10,110,"computing and writing stresses",30);
  break;

  case TX_EXITZ88D:
    if(LANG == 1) TextOut(hDC,10,130,"Ende Z88D",9);
    if(LANG == 2) TextOut(hDC,10,130,"Z88D done",9);
  break;

  }
return(0);
}

/***********************************************************************
*  function wtyp88d gibt Elementtypen in Z88D aus
***********************************************************************/ 
int wtyp88d(FR_INT4 k,FR_INT4 i)
{
extern HDC hDC;
extern FR_INT4 LANG;

size_t laenge;

char cline[80];

if(LANG == 1) sprintf(cline,"Nr. %5ld Typ %5ld",k,i);
if(LANG == 2) sprintf(cline,"no. %5ld type %5ld",k,i);

laenge= strlen(cline);
TextOut(hDC,10,90,cline,laenge);

return(0);
}

