        CONTROL "",                           IDDLG_V_TEXT2, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_THICKFRAME | WS_TABSTOP, 91, 31, 207, 16
