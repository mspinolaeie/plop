    MENUITEM "&Netzgeneratordatei\aZ88NI.TXT",         IDM_Z88NITXT
    MENUITEM "&Allgemeine Strukturdaten\aZ88I1.TXT",   IDM_Z88I1TXT
    MENUITEM "&Randbedingungen\aZ88I2.TXT",            IDM_Z88I2TXT
    MENUITEM "&Parameter Spannungen\aZ88I3.TXT",       IDM_Z88I3TXT
    MENUITEM "Parameter Iterationss&olver\aZ88I4.TXT", IDM_Z88I4TXT
    MENUITEM "Datei der &Flaechenlasten\aZ88I5.TXT",   IDM_Z88I5TXT
    MENUITEM SEPARATOR
    MENUITEM "&Info",                                  IDM_WER
    MENUITEM "&Ende",                                  IDM_XIT
    }
  }

