; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{236A5928-B6D7-46D3-B30B-24312DC5F946}
AppName=Gui Plop
AppVerName=Gui Plop 3.0.7
AppPublisher=David Lewis
//AppPublisherURL=http://www.davidlewistoronto.com
//AppSupportURL=http://www.davidlewistoronto.com
//AppUpdatesURL=http://www.davidlewistoronto.com
DefaultDirName={autopf}\Gui Plop
DefaultGroupName=Gui Plop
AllowNoIcons=yes
OutputDir=.
OutputBaseFilename=gui_plop_setup
Compression=lzma
SolidCompression=yes
VersionInfoVersion=3.0.7

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "Win32//\Debug\gui_plop.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "mesh.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "doc\GuiPlop Users Manual.pdf"; DestDir: "{app}"; Flags: ignoreversion
Source: "autocell\*"; DestDir: "{app}\autocell"; Flags: ignoreversion
Source: "..\..\z88src\z88i1plop_xe10\Win32\Debug\z88i1plop.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\z88src\z88i2plop_xe10\Win32\Debug\z88i2plop.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "z88.dyn"; DestDir: "{app}"; Flags: ignoreversion
Source: "z88i4.txt"; DestDir: "{app}"; Flags: ignoreversion
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\Gui Plop"; Filename: "{app}\gui_plop.exe"
Name: "{commondesktop}\Gui Plop"; Filename: "{app}\gui_plop.exe"; Tasks: desktopicon
//Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\Gui Plop"; Filename: "{app}\gui_plop.exe"; Tasks: quicklaunchicon

[Run]
Filename: "{app}\gui_plop.exe"; Description: "{cm:LaunchProgram,Gui Plop}"; Flags: nowait postinstall skipifsilent

[Registry]
Root: HKCR; Subkey: ".gr"; ValueType: string; ValueData: "grfile"
Root: HKCR; Subkey: "grfile"; ValueType: string; ValueData: "Plop control File"
Root: HKCR; Subkey: "grfile\DefaultIcon"; ValueType: string; ValueData: "{app}\mesh.ico"
Root: HKCR; Subkey: "grfile\shell\open\command"; ValueType: string; ValueData: "{app}\gui_plop.exe ""%1"""
Root: HKLM; Subkey: "Software\Lewis\GuiPlop"; ValueType: String; ValueName:"AutoCellLoc"; ValueData: "{app}\autocell\cell"
Root: HKLM; Subkey: "Software\Lewis\GuiPlop"; ValueType: String; ValueName:"HelpFileLoc"; ValueData: "{app}\GuiPlop Users Manual.pdf"
Root: HKLM; Subkey: "Software\Lewis\GuiPlop"; ValueType: String; ValueName:"PlopLoc"; ValueData: "{app}"



